/* ===========================
   COOCO'S DEN – Main Stylesheet
   =========================== */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --gold: #c9a84c;
  --gold-light: #e8c96d;
  --dark: #1a1008;
  --dark2: #2d1f0a;
  --text: #f0e8d8;
  --text-muted: #a89070;
  --white: #fff;
  --red: #b22222;
  --card-bg: #231506;
  --border: rgba(201,168,76,0.25);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Lato', sans-serif;
  background: var(--dark);
  color: var(--text);
  line-height: 1.65;
  overflow-x: hidden;
}

a { color: var(--gold); text-decoration: none; transition: color .2s; }
a:hover { color: var(--gold-light); }

h1,h2,h3,h4 { font-family: 'Playfair Display', serif; }

.container { max-width: 1200px; margin: 0 auto; padding: 0 1.25rem; }

/* ===== BUTTONS ===== */
.btn {
  display: inline-block;
  padding: .7rem 1.6rem;
  border-radius: 4px;
  font-weight: 700;
  font-size: .9rem;
  letter-spacing: .05em;
  cursor: pointer;
  transition: all .25s;
  border: 2px solid transparent;
  text-align: center;
}
.btn-primary {
  background: var(--gold);
  color: var(--dark);
  border-color: var(--gold);
}
.btn-primary:hover { background: var(--gold-light); border-color: var(--gold-light); color: var(--dark); }
.btn-outline {
  background: transparent;
  color: var(--gold);
  border-color: var(--gold);
}
.btn-outline:hover { background: var(--gold); color: var(--dark); }
.btn-danger { background: #c0392b; color: #fff; border-color: #c0392b; }
.btn-danger:hover { background: #a93226; }
.btn-sm { padding: .4rem 1rem; font-size: .8rem; }

/* ===== NAVBAR ===== */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: space-between;
  padding: .75rem 2rem;
  background: rgba(22,12,5,0.96);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  transition: box-shadow .3s;
}
.navbar.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,.7); }
.nav-brand { display: flex; align-items: center; gap: .65rem; }
.brand-logo { font-size: 1.7rem; }
.brand-name { display: block; font-family: 'Playfair Display', serif; font-size: 1.25rem; color: var(--gold); font-weight: 700; letter-spacing: 0.02em; }
.brand-tagline { display: block; font-size: .68rem; color: var(--text-muted); letter-spacing: .08em; text-transform: uppercase; }

/* Horizontal navigation for all screens - NO 3 lines menu */
.nav-toggle { display: none !important; }
.nav-links {
  display: flex; gap: 1.25rem; list-style: none; align-items: center;
  margin: 0; padding: 0;
}
.nav-links a {
  color: var(--text); font-size: .88rem; font-weight: 600;
  padding: .35rem .6rem; border-radius: 6px;
  border-bottom: 2px solid transparent; transition: all .2s;
  white-space: nowrap;
}
.nav-links a:hover, .nav-links a.active {
  color: var(--gold); border-bottom-color: var(--gold);
  background: rgba(201,168,76,0.08);
}

@media (max-width: 768px) {
  .navbar {
    padding: .5rem .75rem;
    flex-direction: column;
    gap: .4rem;
    align-items: center;
  }
  .nav-brand {
    justify-content: center;
    text-align: center;
  }
  .nav-links {
    width: 100%;
    justify-content: center;
    gap: .35rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: .2rem 0;
  }
  .nav-links::-webkit-scrollbar { display: none; }
  .nav-links a {
    font-size: .8rem;
    padding: .25rem .45rem;
  }
  .page-hero {
    padding-top: 8rem !important;
  }
}

/* ===== HERO ===== */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #0d0500 0%, #2d1f0a 50%, #1a1008 100%);
  overflow: hidden;
  text-align: center;
}
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 50% 60%, rgba(201,168,76,0.12) 0%, transparent 70%);
}
.hero-overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
.hero-content { position: relative; z-index: 2; max-width: 720px; padding: 2rem; }
.hero-subtitle { color: var(--gold); font-size: .85rem; letter-spacing: .18em; text-transform: uppercase; margin-bottom: .75rem; }
.hero-title { font-size: clamp(2.4rem, 6vw, 4.5rem); font-weight: 700; line-height: 1.15; color: var(--white); margin-bottom: 1.25rem; }
.hero-title span { color: var(--gold); }
.hero-desc { font-size: 1.05rem; color: var(--text-muted); margin-bottom: 2.2rem; max-width: 560px; margin-left: auto; margin-right: auto; }
.hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.hero-scroll-indicator { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); color: var(--text-muted); font-size: .8rem; animation: bounce 2s infinite; z-index: 2; }
@keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)} }

/* ===== SECTION SHARED ===== */
section { padding: 5rem 0; }
.section-header { text-align: center; margin-bottom: 3rem; }
.section-header h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--gold); margin-bottom: .5rem; }
.section-header p { color: var(--text-muted); }
.section-footer { text-align: center; margin-top: 2.5rem; }

/* ===== HIGHLIGHTS ===== */
.highlights {
  background: var(--dark2);
  padding: 4rem 0;
}
.highlights .container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
}
.highlight-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 2rem 1.5rem;
  text-align: center;
  transition: transform .25s, box-shadow .25s;
}
.highlight-card:hover { transform: translateY(-6px); box-shadow: 0 12px 30px rgba(201,168,76,.15); }
.hi-icon { font-size: 2.5rem; display: block; margin-bottom: 1rem; }
.highlight-card h3 { color: var(--gold); margin-bottom: .5rem; }
.highlight-card p { color: var(--text-muted); font-size: .9rem; }

/* ===== DISHES GRID ===== */
.dishes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.5rem;
}
.dish-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  transition: transform .25s, box-shadow .25s;
  display: flex;
  flex-direction: column;
}
.dish-card:hover { transform: translateY(-5px); box-shadow: 0 10px 28px rgba(201,168,76,.2); }
.dish-img-wrap {
  width: 100%;
  height: 180px;
  overflow: hidden;
  background: #140b03;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.dish-card:hover .dish-img {
  transform: scale(1.08);
}
.dish-emoji { font-size: 3.5rem; padding: 1.5rem; text-align: center; background: rgba(201,168,76,.05); display: block; }
.dish-info { padding: 1.2rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.dish-name { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--white); margin-bottom: .3rem; font-weight: 700; }
.dish-desc { font-size: .85rem; color: var(--text-muted); margin-bottom: .75rem; flex: 1; }
.dish-footer { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: auto; }
.dish-price { color: var(--gold); font-weight: 700; font-size: 1.05rem; }
.dish-badge { font-size: .7rem; padding: .2rem .55rem; border-radius: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.badge-spicy { background: rgba(178,34,34,.25); color: #e74c3c; border: 1px solid #e74c3c44; }
.badge-popular { background: rgba(201,168,76,.2); color: var(--gold); border: 1px solid var(--border); }
.badge-veg { background: rgba(39,174,96,.2); color: #27ae60; border: 1px solid #27ae6044; }
.dish-add-btn { background: var(--gold); color: var(--dark); border: none; padding: .45rem 1rem; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: .85rem; transition: background .2s, transform .15s; }
.dish-add-btn:hover { background: var(--gold-light); transform: scale(1.03); }
.dish-add-btn:active { transform: scale(0.97); }

/* ===== OFFERS PREVIEW ===== */
.offers-preview { background: var(--dark2); }
.offers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}
.offer-card {
  background: var(--card-bg);
  border: 2px solid var(--gold);
  border-radius: 14px;
  padding: 1.75rem;
  position: relative;
  overflow: hidden;
  transition: transform .25s;
}
.offer-card:hover { transform: translateY(-4px); }
.offer-card::before {
  content: '';
  position: absolute; top: 0; right: 0;
  width: 80px; height: 80px;
  background: var(--gold);
  clip-path: polygon(100% 0, 100% 100%, 0 0);
  opacity: .15;
}
.offer-discount {
  display: inline-block;
  background: var(--red);
  color: #fff;
  padding: .25rem .7rem;
  border-radius: 20px;
  font-size: .8rem;
  font-weight: 700;
  margin-bottom: .75rem;
}
.offer-card h3 { color: var(--gold); font-size: 1.15rem; margin-bottom: .4rem; }
.offer-card p { color: var(--text-muted); font-size: .88rem; margin-bottom: .75rem; }
.offer-validity { font-size: .78rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: .5rem; margin-top: .5rem; }
.offer-code { display: inline-block; background: rgba(201,168,76,.15); border: 1px dashed var(--gold); color: var(--gold); padding: .2rem .6rem; border-radius: 4px; font-family: monospace; font-size: .9rem; font-weight: 700; margin-top: .35rem; cursor: pointer; }
.offer-code:hover { background: rgba(201,168,76,.3); }

/* ===== ABOUT ===== */
.about-section { background: var(--dark); }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
@media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; } }
.about-text h2 { color: var(--gold); font-size: 2rem; margin-bottom: 1rem; }
.about-text p { color: var(--text-muted); margin-bottom: 1rem; }
.about-stats { display: flex; gap: 1.5rem; margin-top: 1.5rem; flex-wrap: wrap; }
.stat { text-align: center; }
.stat strong { display: block; font-size: 1.6rem; color: var(--gold); font-family: 'Playfair Display', serif; }
.stat span { font-size: .8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
.visual-box {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
  margin-bottom: 1.25rem;
}
.visual-badge { background: var(--gold); color: var(--dark); font-size: .75rem; font-weight: 700; padding: .2rem .6rem; border-radius: 20px; display: inline-block; margin-bottom: .5rem; text-transform: uppercase; letter-spacing: .06em; }
.visual-box h3 { color: var(--white); margin-bottom: .35rem; }
.visual-box p { color: var(--text-muted); font-size: .88rem; }
.visual-hours {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 1.5rem;
}
.visual-hours h4 { color: var(--gold); margin-bottom: .75rem; }
.visual-hours table { width: 100%; border-collapse: collapse; font-size: .88rem; }
.visual-hours td { padding: .4rem .25rem; color: var(--text-muted); }
.visual-hours td:last-child { text-align: right; color: var(--text); }

/* ===== CONTACT ===== */
.contact-section { background: var(--dark2); }
.contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; }
@media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
.contact-item { display: flex; gap: 1rem; margin-bottom: 1.25rem; }
.contact-item > span { font-size: 1.4rem; line-height: 1; }
.contact-item strong { display: block; color: var(--gold); margin-bottom: .2rem; }
.contact-item p, .contact-item a { color: var(--text-muted); font-size: .9rem; }
.contact-form h3 { color: var(--gold); margin-bottom: 1.25rem; font-size: 1.3rem; }
.contact-form input, .contact-form select, .contact-form textarea {
  width: 100%; display: block; margin-bottom: .85rem;
  background: var(--card-bg);
  border: 1px solid var(--border);
  color: var(--text);
  padding: .7rem .9rem;
  border-radius: 6px;
  font-size: .9rem;
  font-family: 'Lato', sans-serif;
  transition: border-color .2s;
}
.contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus {
  outline: none; border-color: var(--gold);
}
.contact-form select option { background: var(--dark2); }
.form-success { color: #27ae60; background: rgba(39,174,96,.1); border: 1px solid #27ae60; padding: .75rem 1rem; border-radius: 6px; margin-top: .5rem; }

/* ===== FOOTER ===== */
.footer { background: #0d0500; border-top: 1px solid var(--border); padding: 3.5rem 0 1rem; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem; }
@media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; } }
.footer h4 { color: var(--gold); margin-bottom: .85rem; font-size: 1rem; }
.footer p { color: var(--text-muted); font-size: .88rem; line-height: 1.7; }
.footer ul { list-style: none; }
.footer ul li { margin-bottom: .4rem; }
.footer ul a { color: var(--text-muted); font-size: .88rem; }
.footer ul a:hover { color: var(--gold); }
.social-links { display: flex; gap: .75rem; margin-top: .5rem; }
.social-links a { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border); color: var(--text-muted); font-size: .85rem; transition: all .2s; }
.social-links a:hover { background: var(--gold); color: var(--dark); border-color: var(--gold); }
.footer-bottom { border-top: 1px solid var(--border); padding-top: 1.25rem; text-align: center; color: var(--text-muted); font-size: .82rem; }

/* ===== MENU PAGE ===== */
.page-hero {
  padding: 9rem 0 4rem;
  text-align: center;
  background: var(--dark2);
  border-bottom: 1px solid var(--border);
}
.page-hero h1 { color: var(--gold); font-size: 2.8rem; }
.page-hero p { color: var(--text-muted); margin-top: .5rem; }
.menu-filters { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 2.5rem; justify-content: center; }
.filter-btn { padding: .45rem 1.1rem; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; font-size: .88rem; transition: all .2s; }
.filter-btn:hover, .filter-btn.active { background: var(--gold); color: var(--dark); border-color: var(--gold); }
.category-section { margin-bottom: 3.5rem; }
.category-title { color: var(--gold); font-size: 1.4rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; margin-bottom: 1.5rem; }
.menu-item-row {
  display: flex; align-items: center; gap: 1rem;
  padding: .9rem 0;
  border-bottom: 1px solid rgba(201,168,76,.08);
  transition: background .15s;
}
.menu-item-row:hover { background: rgba(201,168,76,.04); }
.item-emoji { font-size: 1.8rem; flex-shrink: 0; }
.item-details { flex: 1; }
.item-name { font-family: 'Playfair Display', serif; color: var(--white); font-size: 1rem; }
.item-desc-sm { color: var(--text-muted); font-size: .82rem; }
.item-price-col { color: var(--gold); font-weight: 700; flex-shrink: 0; font-size: .95rem; }

/* ===== ORDER PAGE ===== */
.order-layout { display: grid; grid-template-columns: 1fr 360px; gap: 2rem; align-items: start; }
@media (max-width: 900px) { .order-layout { grid-template-columns: 1fr; } }
.order-menu { flex: 1; }
.cart-panel {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.5rem;
  position: sticky;
  top: 90px;
}
.cart-panel h3 { color: var(--gold); margin-bottom: 1rem; font-size: 1.2rem; }
.cart-items { min-height: 80px; }
.cart-item { display: flex; justify-content: space-between; align-items: center; gap: .5rem; padding: .6rem 0; border-bottom: 1px solid var(--border); font-size: .88rem; }
.cart-item-name { color: var(--text); flex: 1; }
.cart-qty-controls { display: flex; align-items: center; gap: .3rem; }
.cart-qty-btn { background: var(--dark2); border: 1px solid var(--border); color: var(--gold); width: 24px; height: 24px; border-radius: 4px; cursor: pointer; font-size: 1rem; line-height: 1; display: flex; align-items: center; justify-content: center; }
.cart-qty-btn:hover { background: var(--gold); color: var(--dark); }
.cart-qty { min-width: 20px; text-align: center; color: var(--text); }
.cart-item-price { color: var(--gold); font-weight: 700; min-width: 60px; text-align: right; }
.cart-remove { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 0 2px; }
.cart-remove:hover { color: #e74c3c; }
.cart-empty { text-align: center; color: var(--text-muted); font-size: .9rem; padding: 1.5rem 0; }
.cart-summary { margin-top: 1rem; border-top: 1px solid var(--border); padding-top: .85rem; }
.cart-summary-row { display: flex; justify-content: space-between; font-size: .88rem; color: var(--text-muted); margin-bottom: .35rem; }
.cart-summary-row.total { font-weight: 700; color: var(--gold); font-size: 1rem; }
.cart-actions { margin-top: 1rem; display: flex; flex-direction: column; gap: .6rem; }
.order-type-tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; }
.order-type-tab { flex: 1; padding: .65rem; border: 1px solid var(--border); background: transparent; color: var(--text-muted); border-radius: 6px; cursor: pointer; font-size: .88rem; transition: all .2s; }
.order-type-tab.active { background: var(--gold); color: var(--dark); border-color: var(--gold); font-weight: 700; }
.order-form-fields { display: none; }
.order-form-fields.active { display: block; }
.order-form-fields input, .order-form-fields select, .order-form-fields textarea {
  width: 100%; display: block; margin-bottom: .75rem;
  background: var(--dark);
  border: 1px solid var(--border);
  color: var(--text);
  padding: .65rem .85rem;
  border-radius: 6px;
  font-size: .88rem;
  font-family: 'Lato', sans-serif;
}
.order-form-fields input:focus, .order-form-fields select:focus { outline: none; border-color: var(--gold); }
.order-form-fields label { font-size: .82rem; color: var(--text-muted); margin-bottom: .3rem; display: block; }
.order-coupon { display: flex; gap: .5rem; margin-bottom: .75rem; }
.order-coupon input { flex: 1; }
.order-success {
  display: none;
  background: rgba(39,174,96,.1);
  border: 1px solid #27ae60;
  border-radius: 10px;
  padding: 2rem;
  text-align: center;
  margin-top: 1rem;
}
.order-success h3 { color: #27ae60; font-size: 1.4rem; margin-bottom: .5rem; }
.order-success p { color: var(--text-muted); }

/* ===== OFFERS PAGE ===== */
.offers-hero-strip {
  background: linear-gradient(90deg, var(--gold) 0%, #e8c96d 100%);
  color: var(--dark);
  text-align: center;
  padding: .75rem;
  font-weight: 700;
  font-size: .9rem;
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 1100;
}
.offers-hero-strip + .navbar { top: 38px; }

/* ===== ADMIN LOGIN ===== */
.admin-login-page {
  min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  background: #0d0500;
  padding: 1rem;
}
.login-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  width: 100%;
  max-width: 400px;
  text-align: center;
}
.login-card h2 { color: var(--gold); margin-bottom: .3rem; }
.login-card p { color: var(--text-muted); font-size: .88rem; margin-bottom: 1.5rem; }
.login-card input {
  width: 100%; display: block; margin-bottom: .85rem;
  background: var(--dark2);
  border: 1px solid var(--border);
  color: var(--text);
  padding: .75rem 1rem;
  border-radius: 6px;
  font-size: .95rem;
}
.login-card input:focus { outline: none; border-color: var(--gold); }
.login-error { color: #e74c3c; font-size: .85rem; margin-top: .5rem; display: none; }
.login-lock { font-size: 3rem; margin-bottom: 1rem; }

/* ===== ADMIN PANEL ===== */
.admin-wrap { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
@media (max-width: 900px) { .admin-wrap { grid-template-columns: 1fr; } }
.admin-sidebar {
  background: #0d0500;
  border-right: 1px solid var(--border);
  padding: 1.5rem 0;
  position: sticky; top: 0; height: 100vh;
  overflow-y: auto;
}
@media (max-width: 900px) { .admin-sidebar { position: relative; height: auto; display: flex; flex-wrap: wrap; gap: .25rem; padding: .75rem; border-right: none; border-bottom: 1px solid var(--border); } }
.admin-sidebar-logo { text-align: center; padding: .5rem 1rem 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1rem; }
@media (max-width: 900px) { .admin-sidebar-logo { display: none; } }
.admin-sidebar-logo h2 { color: var(--gold); font-size: 1rem; }
.admin-sidebar-logo p { color: var(--text-muted); font-size: .75rem; }
.admin-nav-item {
  display: flex; align-items: center; gap: .6rem;
  padding: .75rem 1.25rem;
  color: var(--text-muted);
  cursor: pointer;
  transition: all .2s;
  border-left: 3px solid transparent;
  font-size: .9rem;
}
@media (max-width: 900px) { .admin-nav-item { border-left: none; border-radius: 6px; padding: .5rem .75rem; font-size: .82rem; } }
.admin-nav-item:hover, .admin-nav-item.active { color: var(--gold); background: rgba(201,168,76,.08); border-left-color: var(--gold); }
.admin-nav-item span.nav-icon { font-size: 1.1rem; }
.admin-content { padding: 2rem; background: var(--dark); }
.admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
.admin-header h1 { color: var(--gold); font-size: 1.5rem; }
.admin-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
.admin-stat-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 1.25rem; text-align: center; }
.admin-stat-card .stat-num { font-size: 2rem; font-family: 'Playfair Display', serif; color: var(--gold); font-weight: 700; }
.admin-stat-card .stat-label { color: var(--text-muted); font-size: .8rem; }
.admin-section { display: none; }
.admin-section.active { display: block; }
.admin-table-wrap { overflow-x: auto; }
.admin-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
.admin-table th { background: var(--dark2); color: var(--gold); padding: .75rem 1rem; text-align: left; font-weight: 700; border-bottom: 1px solid var(--border); }
.admin-table td { padding: .7rem 1rem; border-bottom: 1px solid rgba(201,168,76,.06); color: var(--text); vertical-align: middle; }
.admin-table tr:hover td { background: rgba(201,168,76,.04); }
.admin-table-actions { display: flex; gap: .4rem; flex-wrap: wrap; }
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,.75); z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  padding: 1rem;
  opacity: 0; pointer-events: none; transition: opacity .25s;
}
.modal-overlay.open { opacity: 1; pointer-events: all; }
.modal-box {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 2rem;
  width: 100%; max-width: 500px;
  max-height: 90vh; overflow-y: auto;
  transform: scale(.95); transition: transform .25s;
}
.modal-overlay.open .modal-box { transform: scale(1); }
.modal-box h3 { color: var(--gold); margin-bottom: 1.25rem; font-size: 1.2rem; }
.modal-box label { font-size: .82rem; color: var(--text-muted); display: block; margin-bottom: .3rem; margin-top: .65rem; }
.modal-box input, .modal-box select, .modal-box textarea {
  width: 100%; display: block;
  background: var(--dark2);
  border: 1px solid var(--border);
  color: var(--text);
  padding: .65rem .85rem;
  border-radius: 6px;
  font-size: .9rem;
  font-family: 'Lato', sans-serif;
  margin-bottom: .1rem;
}
.modal-box input:focus, .modal-box select:focus { outline: none; border-color: var(--gold); }
.modal-box select option { background: var(--dark2); }
.modal-actions { display: flex; gap: .75rem; justify-content: flex-end; margin-top: 1.25rem; flex-wrap: wrap; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
@media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
.order-status { padding: .2rem .55rem; border-radius: 12px; font-size: .78rem; font-weight: 700; text-transform: uppercase; }
.status-pending { background: rgba(243,156,18,.2); color: #f39c12; }
.status-preparing { background: rgba(52,152,219,.2); color: #3498db; }
.status-ready { background: rgba(39,174,96,.2); color: #27ae60; }
.status-delivered { background: rgba(127,140,141,.2); color: #7f8c8d; }
.status-cancelled { background: rgba(231,76,60,.2); color: #e74c3c; }
.toggle-switch { position: relative; display: inline-block; width: 46px; height: 24px; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #444; border-radius: 24px; transition: .3s; }
.slider::before { content: ''; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: .3s; }
input:checked + .slider { background: var(--gold); }
input:checked + .slider::before { transform: translateX(22px); }
.notification-dot {
  display: inline-block;
  background: var(--red);
  color: #fff;
  font-size: .65rem;
  font-weight: 700;
  width: 18px; height: 18px;
  border-radius: 50%;
  text-align: center; line-height: 18px;
  margin-left: .3rem;
  vertical-align: middle;
}

/* ===== TOAST ===== */
.toast {
  position: fixed; bottom: 1.5rem; right: 1.5rem;
  background: var(--gold); color: var(--dark);
  padding: .85rem 1.5rem;
  border-radius: 8px;
  font-weight: 700;
  z-index: 9999;
  transform: translateY(100px);
  opacity: 0;
  transition: all .3s;
  max-width: 300px;
}
.toast.show { transform: translateY(0); opacity: 1; }
.toast.error { background: #e74c3c; color: #fff; }

/* ===== CART FLOAT BUTTON (BOTTOM RIGHT) ===== */
.cart-float {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  background: linear-gradient(135deg, #c9a84c 0%, #e6a834 100%);
  color: #1a0f04;
  border: 2px solid #fff2cb;
  border-radius: 50px;
  padding: .75rem 1.35rem;
  font-weight: 800;
  cursor: pointer;
  display: none;
  align-items: center;
  gap: .65rem;
  font-size: .95rem;
  box-shadow: 0 8px 30px rgba(0,0,0,.6), 0 0 16px rgba(201,168,76,.4);
  z-index: 9999;
  transition: transform .25s ease, box-shadow .25s ease;
  animation: cartFloatPulse 2.5s infinite;
}
@keyframes cartFloatPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}
.cart-float:hover {
  background: #f1cc65;
  transform: scale(1.08) translateY(-2px);
  box-shadow: 0 10px 35px rgba(0,0,0,.7), 0 0 25px rgba(201,168,76,.6);
}
.cart-float-count {
  background: #b22222;
  color: #fff;
  border-radius: 50%;
  min-width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .78rem;
  font-weight: 800;
  padding: 0 4px;
  box-shadow: 0 2px 6px rgba(0,0,0,.4);
}
.cart-float-total {
  font-size: .85rem;
  background: rgba(26,16,8,.15);
  padding: .2rem .5rem;
  border-radius: 12px;
}

/* ===== MOBILE RESPONSIVE ===== */
@media (max-width: 768px) {
  .cart-float {
    bottom: 1.2rem;
    right: 1.2rem;
    padding: .7rem 1.15rem;
    font-size: .9rem;
  }
}
@media (max-width: 600px) {
  .hero-btns { flex-direction: column; align-items: center; }
  .admin-content { padding: 1rem; }
}
